# Local environment of invoiceops-stack (used with compose.local.yml). Safe to commit: every value
# is a THROWAWAY secret that only protects a stack running on your own laptop, bound to loopback.
# NEVER reuse any of these values on a server. Production values live in
# /opt/invoiceops/invoiceops.env (outside git); see invoiceops-app/ops/production.env.example.
#
#   docker compose -p invoiceops-local -f compose.yml -f compose.local.yml --env-file local.example.env up -d
#
# Secret scanners (gitleaks, trufflehog, GitHub push protection): put this file in their allowlist
# (for gitleaks: a [allowlist] paths entry for ^local\.example\.env$). No other committed env example
# may contain any of these values; tests/test_env_examples.py enforces it.
#
# This file is deliberately not named .env*, so tools that block dotenv files keep working.

# --- Where the sibling repositories are (relative to this directory) -----------------------
# Server default is ../app, ../mlflow, ../model-api and ../ml; locally they are invoiceops-*.
INVOICEOPS_APP_DIR=../invoiceops-app
INVOICEOPS_MLFLOW_DIR=../invoiceops-mlflow
INVOICEOPS_MODEL_API_DIR=../invoiceops-model-api
# Build context "ml" of the Model API, relative to INVOICEOPS_MODEL_API_DIR.
INVOICEOPS_ML_CONTEXT=../invoiceops-ml

# --- Local project (compose.local.yml) ---------------------------------------------------------
# Own project, volumes and networks: it never touches the production names.
LOCAL_PROJECT=invoiceops-local
# linux/arm64 on Apple Silicon; use linux/amd64 on an Intel Mac or Linux PC.
LOCAL_PLATFORM=linux/arm64
# Loopback ports of the web (app) and of the MLflow gateway. If you change them, change the
# four origins below too (the port is part of the origin).
LOCAL_APP_PORT=8100
LOCAL_MLFLOW_PORT=8101

# --- Origins: distinct hosts so the two session cookies never mix --------------------------
# *.localhost resolves to loopback in every browser; no /etc/hosts entry needed.
PUBLIC_ORIGIN=http://invoiceops.localhost:8100
APP_PUBLIC_URL=http://invoiceops.localhost:8100
MLFLOW_PUBLIC_URL=http://mlflow-invoiceops.localhost:8101
GATEWAY_PUBLIC_ORIGIN=http://mlflow-invoiceops.localhost:8101

# --- Internal URLs (docker network, identical to production) -----------------------------
MODEL_API_URL=http://invoiceops-model-api:8000
MLFLOW_GATEWAY_INTERNAL_URL=http://invoiceops-mlflow-gateway:8080

